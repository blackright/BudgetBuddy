<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 12 (API 31) and higher — FR-042, FR-043.

  The PIN verifier and the lockout record live in flutter_secure_storage, which
  is backed by this app's shared preferences. They must never leave the device:
  a restored verifier would let a new install accept the old PIN, and a restored
  lockout would carry a stale wait across a reinstall.

  Everything else keeps the system default (the <include> is deliberately absent,
  so all other content is still backed up).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
